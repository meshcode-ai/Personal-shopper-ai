# 전부 선택 사항이다 — 키가 없어도 앱은 그대로 동작한다.
# 구매내역/상품 상세/가격 비교는 기본적으로 chrome_bridge(MeshCode)와 이미 쓰고 있는
# 코딩 에이전트(Claude, Codex 등)의 LLM으로 처리된다. 아래 값은 서버가 자동 배경 스캔
# (넛지 배너)을 조금 더 정교하게 하고 싶을 때만 선택적으로 채우면 된다.

# --- Qwen Cloud / Alibaba Cloud Model Studio (선택 — 없으면 mock 응답) ---
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

# --- Bright Data (선택 — 없으면 mock 가격 provider) ---
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=

# --- Local ---
PORT=8787
DB_PATH=./data/personal-shopper.sqlite
KEYCHAIN_PREFIX=personal-shopper
